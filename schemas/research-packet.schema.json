{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "genre", "research_date", "candidates", "research_rejections"],
  "properties": {
    "schema_version": {"const": 1},
    "genre": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "research_date": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"},
    "candidates": {"type": "array", "maxItems": 200, "items": {"$ref": "#/definitions/candidate"}},
    "research_rejections": {"type": "array", "maxItems": 500, "items": {"$ref": "#/definitions/rejection"}}
  },
  "definitions": {
    "text": {"type": "string", "minLength": 1, "maxLength": 10000},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["url", "purpose"],
      "properties": {
        "url": {"type": "string", "minLength": 10, "maxLength": 2048},
        "purpose": {"enum": ["identity", "structure", "review", "whole_runtime"]}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["imdb_id", "type", "title", "year", "reason", "sources", "dna", "dna_confidence", "dna_tags"],
      "properties": {
        "imdb_id": {"type": "string", "pattern": "^tt[0-9]+$"},
        "type": {"enum": ["movie", "series"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "year": {"type": "integer", "minimum": 1800, "maximum": 2200},
        "reason": {"$ref": "#/definitions/text"},
        "sources": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"$ref": "#/definitions/source"}},
        "dna": {"type": "object", "additionalProperties": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 10}, {"type": "null"}]}},
        "dna_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "dna_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "external_ids": {"type": "object", "additionalProperties": false, "properties": {"kitsu": {"type": "string", "minLength": 1, "maxLength": 100}}}
      }
    },
    "rejection": {
      "type": "object", "additionalProperties": false, "required": ["title", "reason"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "reason": {"$ref": "#/definitions/text"},
        "type": {"enum": ["movie", "series"]},
        "year": {"type": "integer", "minimum": 1800, "maximum": 2200},
        "imdb_id": {"anyOf": [{"type": "string", "pattern": "^tt[0-9]+$"}, {"type": "null"}]}
      }
    }
  }
}
